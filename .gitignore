# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ficheros de entorno: ninguno se versiona...
.env*

# ...salvo la plantilla, que es justo lo que documenta qué variables hacen falta
# y no contiene ningún valor.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Sibila ───────────────────────────────────────────────────────────────

# Informes de cobertura de las pruebas.
/coverage

# Trazas y capturas que deja el navegador de pruebas.
/.playwright-mcp

# Capturas de verificación del desarrollo: se regeneran abriendo la página.
# Las de la investigación de campo sí se versionan, en docs/investigacion.
#
# Se excluye el CONTENIDO y no la carpeta: git no desciende a un directorio
# excluido, así que con `/docs/capturas/` la excepción de abajo no rescataría
# nada. Con `/*` sí.
/docs/capturas/*

# Excepción: las que son la evidencia de una decisión ya tomada y documentada.
# Una captura de depuración caduca; ésta es la referencia de cómo tiene que
# verse algo, y se versiona junto a la decisión que la cita.
!/docs/capturas/referencia/

# Lienzo de diseño: las fuentes son los .dc.html y canvas.json, que sí se
# versionan. El .html publicable pesa 2,5 MB y se reconstruye con seed-canvas.
/docs/lienzo/*.html
!/docs/lienzo/*.dc.html

# Secuencias pre-renderizadas de las cartas: binarios pesados, fuera de git.
/public/cartas/*.mp4
/public/cartas/*.webm

# Artefactos del arnés de pantalla: trazas, capturas de fallo e informe HTML.
# La prueba es el fichero; su salida se regenera con `npm run pruebas:pantalla`.
/pruebas-de-pantalla/salida
/playwright-report
/blob-report
/.playwright
