# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ficheros de entorno: ninguno se versiona...
.env*

# ...salvo la plantilla, que es justo lo que documenta qué variables hacen falta
# y no contiene ningún valor.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Sibila ───────────────────────────────────────────────────────────────

# Informes de cobertura de las pruebas.
/coverage

# Trazas y capturas que deja el navegador de pruebas.
/.playwright-mcp

# Capturas de verificación del desarrollo: se regeneran abriendo la página.
# Las capturas de la investigación de campo sí se versionan, en docs/investigacion.
/docs/capturas/

# Lienzo de diseño: las fuentes son los .dc.html y canvas.json, que sí se
# versionan. El .html publicable pesa 2,5 MB y se reconstruye con seed-canvas.
/docs/lienzo/*.html
!/docs/lienzo/*.dc.html

# Secuencias pre-renderizadas de las cartas: binarios pesados, fuera de git.
/public/cartas/*.mp4
/public/cartas/*.webm
