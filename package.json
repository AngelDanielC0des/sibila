{
  "name": "astrosoul",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage",
    "validar:nucleos": "node --experimental-strip-types --no-warnings scripts/validar-nucleos.mts",
    "pruebas:pantalla": "playwright test",
    "pruebas:pantalla:ui": "playwright test --ui",
    "verificar": "npm run typecheck && npm run lint && npm run lint:css && npm run test && npm run validar:nucleos",
    "prepare": "husky",
    "corpus": "node --experimental-strip-types --no-warnings scripts/avance-corpus.mts",
    "corpus:leer": "node --experimental-strip-types --no-warnings scripts/leer-corpus.mts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.4",
    "next-intl": "^4.14.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,mjs}": [
      "prettier --write"
    ]
  }
}
