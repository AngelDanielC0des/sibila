# Variables de entorno de Sibila
#
# Este fichero es la plantilla y SÍ se versiona. El `.env` real no: `.gitignore`
# excluye `.env*` precisamente para que una clave no acabe en un commit.
#
# Al añadir una variable nueva, añádela aquí también, con su explicación y sin
# su valor. Una variable que sólo existe en la máquina de quien la escribió es
# una avería esperando al siguiente despliegue.

# ─── Sitio ────────────────────────────────────────────────────────────────────

# URL pública, con protocolo y sin barra final. La usan los enlaces canónicos,
# los `hreflang` y el sitemap, que necesitan URL absoluta.
NEXT_PUBLIC_URL_DEL_SITIO="http://localhost:3000"

# ─── Síntesis · bloque A5, aún sin decidir (D3) ───────────────────────────────

# Proveedor del modelo que genera la síntesis conjunta. **Nunca se llama al
# modelo en el camino gratuito**: sólo detrás del muro de pago.
# Sin prefijo NEXT_PUBLIC_: esta clave jamás puede llegar al navegador.
CLAVE_DEL_MODELO=""

# Identificador del modelo. Se fija aquí y no en el código para poder cambiarlo
# sin desplegar.
MODELO_DE_SINTESIS=""

# ─── Cobro · bloque A5, aún sin decidir (D4) ──────────────────────────────────

# Pasarela de pago. La clave pública puede ir al navegador; la secreta no, y por
# eso sólo una lleva el prefijo.
NEXT_PUBLIC_CLAVE_PUBLICA_DE_PAGO=""
CLAVE_SECRETA_DE_PAGO=""

# Secreto con el que se firman los avisos de la pasarela. Sin verificar la firma,
# cualquiera podría avisar de un pago que no ha ocurrido.
SECRETO_DE_AVISOS_DE_PAGO=""

# ─── Persistencia · bloque A5 ─────────────────────────────────────────────────

# Base de datos de lecturas e historial. El corpus NO vive aquí: son ficheros
# estáticos versionados en git, y ese es el motivo de que el camino gratuito
# tenga latencia nula.
URL_DE_BASE_DE_DATOS=""
